    "rollup-plugin-dts": "^6.5.1",
    "terser": "^5.51.2"
  },
  "devDependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@rstackjs/test-utils": "^1.0.0",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "24.19.2",
    "chalk": "^6.0.1",
    "fast-glob": "^3.3.3",
    "fs-extra": "^11.4.1",
    "rslog": "^2.3.0",
    "rstack": "^0.8.3",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@12.11.2",
